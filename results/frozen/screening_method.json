{
  "primary_bandwidth_miles": 10,
  "numeric_balance_variables": [
    "age_2025",
    "log_adt",
    "structure_length_m",
    "max_span_m",
    "deck_width_m"
  ],
  "core_categorical_balance_variables": [
    "structure_kind_code",
    "structure_type_code",
    "functional_class_code",
    "highway_system_code"
  ],
  "separability_variables": {
    "numeric": [
      "age_2025",
      "log_adt",
      "structure_length_m",
      "max_span_m",
      "deck_width_m"
    ],
    "categorical": [
      "structure_kind_code",
      "structure_type_code",
      "functional_class_code",
      "highway_system_code",
      "design_load_code",
      "owner_code",
      "maintenance_code"
    ]
  },
  "separability_cv": {
    "folds": 3,
    "shuffle": true,
    "random_state": 42,
    "foldwise_preprocessing": true
  },
  "priority_thresholds": {
    "high": {
      "min_side_n": 200,
      "mean_abs_smd_max": 0.25,
      "auc_max": 0.9,
      "core_cat_mean_v_max": 0.5,
      "coverage_min": 0.7
    },
    "secondary": {
      "min_side_n": 100,
      "mean_abs_smd_max": 0.35,
      "auc_max": 0.93,
      "core_cat_mean_v_max": 0.6,
      "coverage_min": 0.5
    }
  },
  "score_weights": {
    "sample": 0.2,
    "numeric_balance": 0.25,
    "categorical_similarity": 0.2,
    "separability": 0.2,
    "geographic_coverage": 0.15
  },
  "outcome_used_in_screening": false
}